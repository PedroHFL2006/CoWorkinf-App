GET http://localhost:3000/salas
Accept: application/json

---

# Listar salas disponíveis para uma data e turno específicos
GET http://localhost:3000/salas?dia=2026-08-15&turno=Manhã
Accept: application/json

---

GET http://localhost:3000/salas/1
Accept: application/json

---

POST http://localhost:3000/salas
Content-Type: application/json

{
    "nome": "Sala Alpha",
    "capacidade": 10,
    "descricao": "Sala com projetor e ar-condicionado",
    "precoLocacao": 150.00
}

---

POST http://localhost:3000/salas
Content-Type: application/json

{
    "nome": "S",
    "capacidade": -5,
    "precoLocacao": 0
}

---

PUT http://localhost:3000/salas/1
Content-Type: application/json

{
    "nome": "Sala Alpha Renovada",
    "capacidade": 15,
    "descricao": "Sala reformada com novos equipamentos",
    "precoLocacao": 200.00
}

---

DELETE http://localhost:3000/salas/1

